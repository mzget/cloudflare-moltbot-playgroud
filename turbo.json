{
  "$schema": "https://v2-11-10.turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".astro/**"]
    },
    "type-check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "cf-typegen": {
      "outputs": ["worker-configuration.d.ts"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
